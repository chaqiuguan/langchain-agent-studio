# ============================================================
# AgentStudio 智能体工坊 —— 环境变量示例
# 复制本文件为 .env 后填写，.env 已被 .gitignore 忽略，不会泄露
# ============================================================

# ---------- 必填：大模型 ----------
# 服务商：deepseek / openai / moonshot / qwen / zhipu / siliconflow / custom
LLM_PROVIDER=deepseek

# API Key（留空时会读取对应服务商的专属变量，如 DEEPSEEK_API_KEY）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型名称（留空则用服务商默认模型）
# deepseek: deepseek-chat / deepseek-reasoner
# qwen:     qwen-plus / qwen-turbo / qwen-max
# zhipu:    glm-4-flash / glm-4-plus
LLM_MODEL=deepseek-chat

# 接口地址（一般不用改；换成任意 OpenAI 兼容网关时才需要）
# LLM_BASE_URL=https://api.deepseek.com/v1

# ---------- 可选：生成参数 ----------
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# ---------- 可选：智能体行为 ----------
# 单轮最多调用工具的次数（防止死循环）
AGENT_MAX_ITERATIONS=6
# 记住最近几轮对话
AGENT_MEMORY_WINDOW=8
# 智能体模式：tool_calling（推荐，需模型支持函数调用） / react（纯文本推理）
AGENT_MODE=tool_calling
# 启用的工具，逗号分隔；留空表示全部
AGENT_TOOLS=web_search,calculator,current_datetime,read_file
# 是否把 ReAct 过程打印到终端
AGENT_VERBOSE=false

# ---------- 可选：本地能力 ----------
# read_file 工具只能读取这个目录内的文件
AGENT_DATA_DIR=data

# 搜索后端：auto（Bing 优先、ddgs 兜底）/ bing / ddg
# 国内网络建议保持 auto 或 bing
SEARCH_PROVIDER=auto
